{
  "name": "raftkv",
  // GitHub's default Codespaces image: Docker and Go are preinstalled, and it
  // is cached by Codespaces, so the codespace starts quickly.
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "cpus": 2 },
  "forwardPorts": [8001, 3000],
  "portsAttributes": {
    "8001": { "label": "raftkv API (node 1)" },
    "3000": { "label": "Grafana dashboard" }
  },
  "postAttachCommand": "echo 'Start the demo cluster: ./scripts/codespace-demo.sh'"
}
